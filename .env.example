# Copy to .env.local (git-ignored).
# VITE_GAS_URL = the Web App URL of the Apps Script deployment (Deploy > Manage deployments), ending in /exec.
# It is public by nature; the secrets (PIN pepper, admin password hash …) stay in the script's Script Properties.
VITE_GAS_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
